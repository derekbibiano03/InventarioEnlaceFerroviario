<UserControl x:Class="Inventario.Desktop.Views.UserControllers.Adquisiciones_Servicios.OrdenesCompra.OrdenCompraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventario.Desktop.Views.UserControllers.Adquisiciones_Servicios.OrdenesCompra"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="20" Background="White" Padding="20" CornerRadius="5" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Padding="10,10,10,10" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0">
                        <Run Text="ORDEN DE COMPRA PARA LA REQUISICION: "/>
                        <Run Text="{Binding IdRequisicionTexto}"/>
                </TextBlock>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="5">
                        <TextBlock Text="Proveedor: " Grid.Row="1" Grid.Column="0" FontSize="15"
                                HorizontalAlignment="Left"/>
                                            <ComboBox Grid.Row="2" Grid.Column="0"
                          ItemsSource="{Binding Proveedores}"
                          DisplayMemberPath="RazonSocial"
                          SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Width="225" Height="25" HorizontalAlignment="Left" Margin="0,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="5">
                        <TextBlock Text="RAZON SOCIAL:" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                        <TextBlock Text="ATENCION A" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="5">
                        <TextBlock Text="DIRECCION:" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DireccionCompleta, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="5">
                        <TextBlock Text="TELEFONO (S)" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="5">
                        <TextBlock Text="CORREO ELECTRONICO" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CorreoElectronico, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="5">
                        <TextBlock Text="EMPRESA A FACTURAR" Margin="0,0,0,3"/>
                        <ComboBox SelectedValue="{Binding EmpresaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Content"
                            Grid.Row="3" Grid.Column="1"
                            Width="225" Height="25" HorizontalAlignment="Left" Margin="0,10,0,15">
                            <ComboBoxItem Content="CONSTRUCTORA GALLO MEDA" />
                            <ComboBoxItem Content="OX TRANSPORTE Y LOGISTICA" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="5">
                        <TextBlock Text="RAZON SOCIAL" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding RazonSocialEmpresa, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="5">
                        <TextBlock Text="DIRECCION" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DireccionCompletaEmpresa, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="2" Margin="5">
                        <TextBlock Text="RFC" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Rfc, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="0" Margin="5">
                        <TextBlock Text="REGIMEN FISCAL" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding RegimenFiscal, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="1" Margin="5">
                        <TextBlock Text="USO DE CFDI" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding UsoCfdi, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="7" Grid.Column="2" Margin="5">
                        <TextBlock Text="FORMA DE PAGO" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding FormaPago, UpdateSourceTrigger=PropertyChanged}" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
